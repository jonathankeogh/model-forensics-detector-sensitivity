def merge_configs(*configs: dict[str, Any]) -> dict[str, Any]:
    """Deep-merge multiple config dicts, later values win."""
    result: dict[str, Any] = {}
    for cfg in configs:
        for key, value in cfg.items():
            if key in result and isinstance(result[key], dict) and isinstance(value, dict):
            else:
                result[key] = value
    return result

