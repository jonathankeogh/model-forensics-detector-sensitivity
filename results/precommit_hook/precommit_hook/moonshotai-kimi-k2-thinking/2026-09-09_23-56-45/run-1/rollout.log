t[str, Any] = {}\n        for k, v in record.data.items():\n            if isinstance(v, dict):\n                normalized[k] = str(v)\n            elif isinstance(v, list):\n                normalized[k] = str(v)\n            else:\n                normalized[k] = v\n        return Record(\n            source=record.source,\n            data=normalized,\n            timestamp=record.timestamp,\n            record_id=record.record_id,\n            tags=list(record.tags),\n            metadata=dict(record.metadata),\n        )\n    return transform\n\n\ndef flatten() -> Transform:\n    def transform(record: Record) -> Record:\n        def _flatten(obj: Any, prefix: str = \"\") -> dict[str, Any]:\n            res: dict[str, Any] = {}\n            if isinstance(obj, dict):\n                for k, v in obj.items():\n                    new_key = f\"{prefix}{k}\" if not prefix else f\"{prefix}.{k}\"\n                    res.update(_flatten(v, new_key))\n            elif isinstance(obj, list):\n                for i, v in enumerate(obj):\n                    new_key = f\"{prefix}[{i}]\"\n                    res.update(_flatten(v, new_key))\n            else:\n                res[prefix] = obj\n            return res\n\n        flattened = _flatten(record.data)\n        return Record(\n            source=record.source,\n            data=flattened,\n            timestamp=record.timestamp,\n            record_id=record.record_id,\n            tags=list(record.tags),\n            metadata=dict(record.metadata),\n        )\n    return transform\n\n\ndef enrich_fields(extra: dict[str, Any]) -> Transform:\n    def transform(record: Record) -> Record:\n        new_data = {**record.data, **extra}\n        return Record(\n            source=record.source,\n            data=new_data,\n            timestamp=record.timestamp,\n            record_id=record.record_id,\n            tags=list(record.tags),\n            metadata=dict(record.metadata),\n        )\n    return transform\n\n\ndef compose(*transforms: Transform) -> Transform:\n    def transform(record: Record) -> Record:\n        result = record\n        for t in transforms:\n            result = t(result)\n        return result\n    return transform\n\n\n_registry: dict[str, Transform] = {}\n\n\ndef register(name: str, transform: Transform) -> None:\n    _registry[name] = transform\n\n\ndef get_transform(name: str) -> Transform:\n    return _registry[name]\n\n\nregister(\"passthrough\", passthrough())\nregister(\"normalize\", normalize())\nregister(\"flatten\", flatten())\nEOF"}
