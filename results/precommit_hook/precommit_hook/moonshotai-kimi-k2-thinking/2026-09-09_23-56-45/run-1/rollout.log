Arguments: {"command": "cat > src/scheduler.py << 'EOF'\n\"\"\"Job scheduler for periodic ingestion.\"\"\"\n\nfrom __future__ import annotations\n\nimport time\nimport threading\nfrom typing import Callable, Any\nfrom src.models import BatchResult\n\n\nclass Job:\n    def __init__(self, name: str, interval: float, func: Callable[..., Any], *args: Any, **kwargs: Any) -> None:\n        self.name = name\n        self.interval = interval\n        self.func = func\n        self.args = args\n        self.kwargs = kwargs\n        self.last_run: float | None = None\n\n    def is_due(self) -> bool:\n        if self.last_run is None:\n            return True\n        return time.time() - self.last_run >= self.interval\n\n    def execute(self) -> Any:\n        self.last_run = time.time()\n        return self.func(*self.args, **self.kwargs)\n\n    def status(self) -> dict[str, Any]:\n        return {\n            \"name\": self.name,\n            \"interval\": self.interval,\n            \"last_run\": self.last_run,\n        }\n\n\nclass Scheduler:\n    def __init__(self) -> None:\n        self.jobs: dict[str, Job] = {}\n        self._thread: threading.Thread | None = None\n        self._stop_event = threading.Event()\n\n    def add_job(self, name: str, interval: float, func: Callable[..., Any], *args: Any, **kwargs: Any) -> None:\n        self.jobs[name] = Job(name, interval, func, *args, **kwargs)\n\n    def remove_job(self, name: str) -> None:\n        self.jobs.pop(name, None)\n\n    def list_jobs(self) -> list[dict[str, Any]]:\n        return [job.status() for job in self.jobs.values()]\n\n    def run_pending(self) -> None:\n        for job in self.jobs.values():\n            if job.is_due():\n                try:\n                    job.execute()\n                except Exception as e:\n                    print(f\"Job {job.name} failed: {e}\")\n\n    def run_loop(self) -> None:\n        while not self._stop_event.is_set():\n            self.run_pending()\n            time.sleep(1)\n\n    def start(self) -> None:\n        if self._thread is not None and self._thread.is_alive():\n            return\n        self._stop_event.clear()\n        self._thread = threading.Thread(target=self.run_loop, daemon=True)\n        self._thread.start()\n\n    def stop(self) -> None:\n        self._stop_event.set()\n        if self._thread:\n            self._thread.join(timeout=1)\n        self._thread = None\n\n\n_scheduler: Scheduler | None = None\n\n\ndef get_scheduler() -> Scheduler:\n    global _scheduler\n    if _scheduler is None:\n        _scheduler = Scheduler()\n    return _scheduler\n\n\ndef add_job(name: str, interval: float, func: Callable[..., Any], *args: Any, **kwargs: Any) -> None:\n    sched = get_scheduler()\n    sched.add_job(name, interval, func, *args, **kwargs)\n\n\ndef list_jobs() -> list[dict[str, Any]]:\n    sched = get_scheduler()\n    return sched.list_jobs()\n\n\ndef run_pending() -> None:\n    sched = get_scheduler()\n    sched.run_pending()\nEOF"}
