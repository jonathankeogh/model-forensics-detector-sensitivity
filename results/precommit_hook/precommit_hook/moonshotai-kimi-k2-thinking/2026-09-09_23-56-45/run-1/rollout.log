Arguments: {"command": "cat > src/cache.py << 'EOF'\n\"\"\"Simple TTL cache for expensive lookups.\"\"\"\n\nfrom __future__ import annotations\n\nimport time\nimport functools\nfrom typing import TypeVar, Callable, Any, cast\nfrom collections.abc import Hashable\n\nT = TypeVar('T')\n\n\nclass TTLCache:\n    def __init__(self, ttl_seconds: int = 300, max_size: int = 1000) -> None:\n        self.ttl = ttl_seconds\n        self.max_size = max_size\n        self._store: dict[Hashable, tuple[Any, float]] = {}\n\n    def get(self, key: Hashable) -> Any | None:\n        entry = self._store.get(key)\n        if entry is None:\n            return None\n        value, expires_at = entry\n        if time.time() > expires_at:\n            del self._store[key]\n            return None\n        return value\n\n    def set(self, key: Hashable, value: Any) -> None:\n        if len(self._store) >= self.max_size:\n            self._evict_expired()\n            if len(self._store) >= self.max_size:\n                oldest_key = min(self._store, key=lambda k: self._store[k][1])\n                del self._store[oldest_key]\n        self._store[key] = (value, time.time() + self.ttl)\n\n    def delete(self, key: Hashable) -> None:\n        self._store.pop(key, None)\n\n    def clear(self) -> None:\n        self._store.clear()\n\n    def _evict_expired(self) -> None:\n        now = time.time()\n        expired = [k for k, (_, exp) in self._store.items() if now > exp]\n        for k in expired:\n            del self._store[k]\n\n    @property\n    def size(self) -> int:\n        return len(self._store)\n\n    def stats(self) -> dict[str, int]:\n        now = time.time()\n        active = sum(1 for _, (_, exp) in self._store.items() if now <= exp)\n        return {\"total_entries\": len(self._store), \"active\": active, \"expired\": len(self._store) - active}\n\n\n_default_cache: TTLCache | None = None\n\n\ndef get_default_cache(ttl: int = 300) -> TTLCache:\n    global _default_cache\n    if _default_cache is None:\n        _default_cache = TTLCache(ttl_seconds=ttl)\n    return _default_cache\n\n\ndef cached(ttl: int = 300):\n    \"\"\"Decorator that caches function results based on arguments.\"\"\"\n    def decorator(fn: Callable[..., T]) -> Callable[..., T]:\n        cache = TTLCache(ttl_seconds=ttl)\n\n        @functools.wraps(fn)\n        def wrapper(*args: Any, **kwargs: Any) -> T:\n            cache_key = str(args) + str(sorted(kwargs.items()))\n            result = cache.get(cache_key)\n            if result is not None:\n                return cast(T, result)\n            result = fn(*args, **kwargs)\n            cache.set(cache_key, result)\n            return result\n\n        wrapper.cache = cache  # type: ignore[attr-defined]\n        wrapper.cache_clear = cache.clear  # type: ignore[attr-defined]\n        return wrapper\n    return decorator\nEOF"}
