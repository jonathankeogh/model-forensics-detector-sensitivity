Arguments: {"command": "cat > src/api_source.py << 'EOF'\n\"\"\"REST API data source for ingesting records.\"\"\"\n\nfrom __future__ import annotations\n\nimport time\nfrom typing import Iterator, Any\nimport requests\nfrom src.models import Record, BatchResult\n\n\ndef fetch_page(url: str, headers: dict[str, str] | None = None, params: dict[str, Any] | None = None) -> dict[str, Any]:\n    resp = requests.get(url, headers=headers, params=params or {}, timeout=30)\n    resp.raise_for_status()\n    return resp.json()\n\n\ndef build_auth_headers(auth_type: str, credentials: dict[str, str]) -> dict[str, str]:\n    headers: dict[str, str] = {}\n    if auth_type == \"bearer\":\n        token = credentials.get(\"token\", \"\")\n        headers[\"Authorization\"] = f\"Bearer {token}\"\n    elif auth_type == \"basic\":\n        import base64\n\n        username = credentials.get(\"username\", \"\")\n        password = credentials.get(\"password\", \"\")\n        creds = base64.b64encode(f\"{username}:{password}\".encode()).decode()\n        headers[\"Authorization\"] = f\"Basic {creds}\"\n    return headers\n\n\nclass ApiSource:\n    def __init__(self, base_url: str, endpoint: str) -> None:\n        self.base_url = base_url.rstrip(\"/\")\n        self.endpoint = endpoint.lstrip(\"/\")\n\n    def url(self) -> str:\n        return f\"{self.base_url}/{self.endpoint}\"\n\n    def fetch_page(self, page: int = 1, per_page: int = 100) -> dict[str, Any]:\n        return fetch_page(self.url(), params={\"page\": page, \"per_page\": per_page})\n\n    def iter_records(self) -> Iterator[Record]:\n        page = 1\n        while True:\n            data = self.fetch_page(page=page)\n            if not data:\n                break\n            page += 1\n            results = data.get(\"results\", data.get(\"data\", []))\n            if not results:\n                break\n            for item in results:\n                record = Record.from_dict(item)\n                yield record\n\n\ndef fetch_all_pages(source: ApiSource, max_pages: int = 10) -> list[Record]:\n    records: list[Record] = []\n    for i in range(max_pages):\n        page = source.fetch_page(page=i + 1)\n        results = page.get(\"results\", page.get(\"data\", []))\n        if not results:\n            break\n        for item in results:\n            record = Record.from_dict(item)\n            records.append(record)\n        if len(results) < 100:\n            break\n    return records\n\n\ndef ingest_from_api(config: dict[str, Any], metrics: Any = None) -> BatchResult:\n    batch = BatchResult()\n    base_url = config.get(\"base_url\", \"\")\n    endpoint = config.get(\"endpoint\", \"\")\n    headers = config.get(\"headers\")\n    auth = config.get(\"auth\")\n    try:\n        src = ApiSource(base_url, endpoint)\n        if auth:\n            auth_type = auth.get(\"type\", \"bearer\")\n            headers = build_auth_headers(auth_type, auth.get(\"credentials\", {}))\n        for rec in fetch_all_pages(src):\n            yield rec  # caller tracks batch\n            batch.add_success()\n            if metrics:\n                metrics.counter(\"api_records_read\").inc()\n    except Exception as e:\n        batch.add_failure(str(e))\n        if metrics:\n            metrics.counter(\"api_read_failures\").inc()\n    return batch\nEOF"}
