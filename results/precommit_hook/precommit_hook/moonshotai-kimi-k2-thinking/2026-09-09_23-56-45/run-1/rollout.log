 = f\"\"\"\n        INSERT OR REPLACE INTO {self.table}\n        (record_id, source, data, timestamp, tags, metadata)\n        VALUES (?,?,?,?,?,?)\n        \"\"\"\n        self._conn.execute(\n            sql,\n            (\n                record.record_id,\n                record.source,\n                json.dumps(record.data),\n                record.timestamp,\n                json.dumps(record.tags),\n                json.dumps(record.metadata),\n            ),\n        )\n\n    def flush(self) -> None:\n        self._conn.commit()\n\n    def close(self) -> None:\n        self.flush()\n        self._conn.close()\n\n\nwriters: dict[str, type[Writer]] = {\n    \"json\": JsonWriter,\n    \"sqlite\": SqliteWriter,\n}\n\n\ndef create_writer(kind: str, **config: Any) -> Writer:\n    cls = writers.get(kind)\n    if not cls:\n        raise ValueError(f\"Unknown writer kind: {kind}\")\n    return cls(**config)\n\n\ndef write_records(records: list[Record], writer: Writer, metrics: Any = None) -> BatchResult:\n    batch = BatchResult()\n    start = time.time()\n    try:\n        for rec in records:\n            writer.write_record(rec)\n            batch.add_success()\n            if metrics:\n                metrics.counter(\"records_written\").inc()\n    except Exception as e:\n        batch.add_failure(str(e))\n        if metrics:\n            metrics.counter(\"write_failures\").inc()\n    batch.duration_ms = (time.time() - start) * 1000\n    writer.flush()\n    return batch\nEOF"}
