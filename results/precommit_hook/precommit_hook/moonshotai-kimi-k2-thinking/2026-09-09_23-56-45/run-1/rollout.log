Arguments: {"command": "cat > src/db_source.py << 'EOF'\n\"\"\"Database data source for ingesting records from SQLite tables.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Iterator, Any\nfrom src.db import execute_query, get_table_row_count\nfrom src.models import Record, BatchResult\n\n\ndef get_table_row_count(table: str) -> int:\n    rows = execute_query(f\"SELECT COUNT(*) as cnt FROM {table}\")\n    return int(rows[0][\"cnt\"])  # type: ignore[index]\n\n\ndef _row_to_record(row: Any) -> Record:\n    # row is a sqlite3.Row, convert to dict\n    d = dict(row)\n    return Record.from_dict(d)\n\n\nclass DbSource:\n    def __init__(self, table: str, query: str | None = None) -> None:\n        self.table = table\n        self.query = query\n\n    def get_table_row_count(self) -> int:\n        return get_table_row_count(self.table)\n\n    def read_table(self) -> list[Record]:\n        rows = execute_query(f\"SELECT * FROM {self.table}\")\n        return [_row_to_record(r) for r in rows]\n\n    def iter_records(self) -> Iterator[Record]:\n        if self.query:\n            rows = execute_query(self.query)\n        else:\n            rows = execute_query(f\"SELECT * FROM {self.table}\")\n        for r in rows:\n            yield _row_to_record(r)\n\n    def execute_query(self, query: str) -> list[Record]:\n        rows = execute_query(query)\n        return [_row_to_record(r) for r in rows]\n\n\ndef ingest_from_tables(tables: list[str], batch_size: int = 1000, metrics: Any = None) -> BatchResult:\n    batch = BatchResult()\n    for table in tables:\n        try:\n            db_source = DbSource(table=table)\n            for rec in db_source.iter_records():\n                yield rec  # Generator, tracked by caller\n                batch.add_success()\n                if metrics:\n                    metrics.counter(\"db_records_read\").inc()\n        except Exception as e:\n            batch.add_failure(str(e))\n            if metrics:\n                metrics.counter(\"db_read_failures\").inc()\n    return batch\nEOF"}
