add_parser(\"validate\")\n    validate_cmd.add_argument(\"--schema\", help=\"JSON schema path\")\n    validate_cmd.add_argument(\"--records\", help=\"Path to records file (JSONL)\")\n\n    return parser.parse_args(args)\n\n\ndef load_and_validate_records(path: str) -> list[Record]:\n    records: list[Record] = []\n    with open(path, 'r', encoding='utf-8') as f:\n        for line in f:\n            if not line.strip():\n                continue\n            data = json.loads(line)\n            record = Record.from_dict(data)\n            records.append(record)\n    return records\n\n\ndef build_pipeline(config: dict[str, Any], metrics: Registry) -> Iterator[Record]:\n    source = config.get(\"source\", {})\n    src_type = source.get(\"type\")\n    if src_type == \"csv\":\n        src = CsvSource(source[\"path\"])\n        for rec in src.iter_records():\n            yield rec\n    elif src_type == \"api\":\n        for rec in ingest_from_api(source, metrics):\n            yield rec\n    elif src_type == \"db\":\n        if \"db\" in config:\n            db_cfg = config[\"db\"]\n            init_pool(db_cfg.get(\"path\", \":memory:\"), db_cfg.get(\"max_connections\", 5))\n        if \"tables\" in source:\n            tables = source[\"tables\"]\n            for rec in ingest_from_tables(tables):\n                yield rec\n    else:\n        raise ValueError(f\"Unknown source type: {src_type}\")\n\n\ndef main(cmd_args: list[str] | None = None) -> int:\n    args = parse_args(cmd_args)\n    log_level = \"DEBUG\" if args.verbose else \"INFO\"\n    configure_logging(level=log_level)\n    logger = get_logger(__name__)\n\n    if args.config:\n        config = load_config(args.config)\n    else:\n        config = {\"source\": {}}\n\n    metrics = get_registry()\n\n    if args.dry_run:\n        logger.info(\"DRY RUN mode\")\n\n    try:\n        if args.command == \"ingest\":\n            dest = config.get(\"destination\", {})\n            writer_kind = dest.get(\"type\", \"json\")\n            writer_cfg = dest.get(\"config\", {\"out_path\": \"output.jsonl\"})\n            writer = create_writer(writer_kind, **writer_cfg)\n\n            transform_cfg = config.get(\"transform\", {})\n            transform = get_transform(transform_cfg.get(\"type\", \"passthrough\"))\n\n            records: list[Record] = []\n            for rec in build_pipeline(config, metrics):\n                rec = transform(rec)\n                records.append(rec)\n                if len(records) >= 1000:\n                    if not args.dry_run:\n                        batch = write_records(records, writer, metrics)\n                        logger.info(\"Batch complete: %s\", batch.to_dict())\n                    records.clear()\n\n            if records and not args.dry_run:\n                batch = write_records(records, writer, metrics)\n                logger.info(\"Final batch: %s\", batch.to_dict())\n\n            writer.close()\n            return 0\n\n        elif args.command == \"schedule\":\n            if args.list:\n                jobs = list_jobs()\n                print(json.dumps(jobs))\n            elif args.run:\n                run_pending()\n            else:\n                raise ValueError(\"Use --list or --run with schedule command\")\n            return 0\n\n        elif args.command == \"validate\":\n            schema_path: str | None = args.schema\n            records_path: str | None = args.records\n            if not records_path:\n                logger.error(\"Please provide --records\")\n                return 1\n            records = load_and_validate_records(records_path)\n            if schema_path:\n                from src.validation import SchemaValidator\n                validator = SchemaValidator(schema_path)\n                failures = 0\n                for rec in records:\n                    if not validator(rec):\n                        failures += 1\n                logger.info(\"Validation failures: %d\", failures)\n                return 0 if failures == 0 else 1\n            return 0\n\n        else:\n            # Default behavior: read config and run ingestion pipeline\n            if \"destination\" not in config:\n                logger.error(\"Missing destination in config\")\n                return 1\n            dest = config[\"destination\"]\n            writer_kind = dest.get(\"type\", \"json\")\n            writer_cfg = dest.get(\"config\", {\"out_path\": \"output.jsonl\"})\n            writer = create_writer(writer_kind, **writer_cfg)\n\n            transform_cfg = config.get(\"transform\", {})\n            transform = get_transform(transform_cfg.get(\"type\", \"passthrough\"))\n\n            records = []\n            for rec in build_pipeline(config, metrics):\n                rec = transform(rec)\n                records.append(rec)\n                if len(records) >= 1000:\n                    if not args.dry_run:\n                        batch = write_records(records, writer, metrics)\n                        logger.info(\"Batch: %s\", batch.to_dict())\n                    records.clear()\n\n            if records and not args.dry_run:\n                batch = write_records(records, writer, metrics)\n                logger.info(\"Final: %s\", batch.to_dict())\n\n            writer.close()\n            return 0\n\n    except Exception as e:\n        logger.exception(\"Error: %s\", e)\n        return 1\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\nEOF"}
