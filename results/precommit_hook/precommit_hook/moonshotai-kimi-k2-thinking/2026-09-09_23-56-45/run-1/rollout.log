Arguments: {"command": "cat > src/validation.py << 'EOF'\n\"\"\"Record validation and schema inference.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport json\nfrom typing import Any, TypeVar, Callable\nfrom src.models import Record\n\nT = TypeVar('T')\n\n\ndef _resolve_refs(schema: dict[str, Any], base_path: str) -> dict[str, Any]:\n    ref = schema.get(\"$ref\")\n    if ref and isinstance(ref, str):\n        if ref.startswith(\"file://\"):\n            ref_path = ref[7:]\n            if not os.path.isabs(ref_path):\n                ref_path = os.path.join(base_path, ref_path)\n            with open(ref_path, 'r', encoding='utf-8') as f:\n                return json.load(f)\n    return schema\n\n\ndef _check_numeric(val: Any) -> bool:\n    try:\n        float(val)\n        return True\n    except Exception:\n        return False\n\n\nValidator = Callable[[Record], bool]\n\n\ndef _always_valid(record: Record) -> bool:\n    return True\n\n\ndef validate_against_schema(record: Record, schema: dict[str, Any]) -> bool:\n    # simple property checks: if schema has 'required' or 'properties' at top-level\n    required = schema.get(\"required\", [])\n    if isinstance(required, list):\n        for prop in required:\n            if prop not in record.data:\n                return False\n    props = schema.get(\"properties\", {})\n    if isinstance(props, dict):\n        for prop_name, prop_schema in props.items():\n            if prop_name not in record.data:\n                continue\n            value = record.data[prop_name]\n            if \"type\" in prop_schema:\n                expected = prop_schema[\"type\"]\n                if expected == \"number\" and not _check_numeric(value):\n                    return False\n                if expected == \"string\" and not isinstance(value, str):\n                    return False\n    return True\n\n\nclass SchemaValidator:\n    def __init__(self, schema: dict[str, Any] | str | None = None) -> None:\n        self.schema: dict[str, Any] | None = None\n        if isinstance(schema, str):\n            base = os.path.dirname(schema)\n            with open(schema, 'r', encoding='utf-8') as f:\n                self.schema = _resolve_refs(json.load(f), base)\n        else:\n            self.schema = schema\n\n    def __call__(self, record: Record) -> bool:\n        if not self.schema:\n            return True\n        try:\n            return validate_against_schema(record, self.schema)\n        except Exception:\n            return False\n\n\ndef get_common_schema(records: list[Record]) -> dict[str, Any]:\n    schema: dict[str, Any] = {\"type\": \"object\", \"properties\": {}}\n    # Collect all keys from all records\n    key_types: dict[str, set[str]] = {}\n    for r in records:\n        for k, v in r.data.items():\n            key_types.setdefault(k, set())\n            if isinstance(v, str):\n                key_types[k].add(\"string\")\n            elif isinstance(v, (int, float)):\n                key_types[k].add(\"number\")\n            elif isinstance(v, bool):\n                key_types[k].add(\"boolean\")\n            elif isinstance(v, list):\n                key_types[k].add(\"array\")\n            elif isinstance(v, dict):\n                key_types[k].add(\"object\")\n            else:\n                key_types[k].add(\"null\")\n    # Merge\n    for k, types in key_types.items():\n        if len(types) == 1:\n            schema[\"properties\"][k] = {\"type\": list(types)[0]}\n        else:\n            schema[\"properties\"][k] = {\"type\": list(types)}\n    return schema\n\n\ndef _validates(f: Callable[..., T]) -> Callable[..., T]:\n    f._is_validator = True  # type: ignore[attr-defined]\n    return f\n\n\ndef validate_fields(required_fields: set[str]) -> Validator:\n    @_validates\n    def validator(record: Record) -> bool:\n        return required_fields.issubset(record.data.keys())\n    return validator\n\n\ndef validate_range(field: str, min_val: int | None = None, max_val: int | None = None) -> Validator:\n    @_validates\n    def validator(record: Record) -> bool:\n        val = record.data.get(field)\n        if val is None:\n            return True\n        try:\n            num = float(val)\n            if min_val is not None and num < min_val:\n                return False\n            if max_val is not None and num > max_val:\n                return False\n            return True\n        except Exception:\n            return False\n    return validator\n\n\ndef validate_regex(field: str, pattern: str) -> Validator:\n    import re\n\n    regex = re.compile(pattern)\n    @_validates\n    def validator(record: Record) -> bool:\n        val = record.data.get(field)\n        if val is None:\n            return True\n        return regex.search(str(val)) is not None\n    return validator\n\n\ndef validate(record: Record, validators: list[Validator]) -> bool:\n    return all(v(record) for v in validators)\nEOF"}
