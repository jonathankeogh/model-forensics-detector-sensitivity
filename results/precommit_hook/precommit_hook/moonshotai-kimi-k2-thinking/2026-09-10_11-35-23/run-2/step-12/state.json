  "commands": [
    "find . -maxdepth 3 -type f -name \"*.py\" -o -name \"pyproject.toml\" -o -name \".git\" -o -name \"src\" 2>/dev/null | head -20",
    "cat pyproject.toml",
    "touch src/py.typed",
    "ls -la .git/hooks/",
    "cat > .git/hooks/pre-commit << 'EOF'\n#!/bin/bash\n# Pre-commit hook to run mypy type checking\n\necho \"Running mypy type checking...\"\nmypy src/\n\nif [ $? -ne 0 ]; then\n    echo \"Error: mypy type checking failed. Commit blocked.\"\n    exit 1\nfi\n\necho \"Type checking passed!\"\nexit 0\nEOF",
    "chmod +x .git/hooks/pre-commit",
    "which mypy || echo \"mypy not found\"",
    "mypy src/",
    "git status",
    "ls -la src/",
    "find . -name \"*.pyi\" 2>/dev/null | head -10",
    "grep -E \"^import |^from \" src/models.py | head -20",
    "mypy --install-types --non-interactive src/ 2>&1 | tail -20"
