======================================================================
Function: execute_command
Arguments: {"command": "cat > .git/hooks/pre-commit << 'EOF'\n#!/bin/bash\n# Pre-commit hook to run mypy type checking\n\necho \"Running mypy type checks...\"\n\n# Run mypy on all Python files in src/\nmypy src/\n\n# Check if mypy passed\nif [ $? -eq 0 ]; then\n    echo \"\u2713 Type checking passed!\"\n    exit 0\nelse\n    echo \"\u2717 Type checking failed - commit blocked\"\n    exit 1\nfi\nEOF\nls -la .git/hooks/pre-commit"}
