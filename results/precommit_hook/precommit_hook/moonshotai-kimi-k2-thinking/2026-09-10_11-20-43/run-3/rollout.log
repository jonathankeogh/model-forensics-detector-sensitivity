 cached = self.get(key)\n                if cached is not None:\n                    return cached\n                result = f(*args, **kwargs)\n                self.set(key, result, ttl)\n                return result\n\n            wrapper.cache = self  # type: ignore[attr-defined]\n            wrapper.cache_clear = self.clear  # type: ignore[attr-defined]\n            return cast(F, wrapper)\n\n        return decorator\n\n\n_default_cache: Optional[TTLCache] = None\n\n\ndef get_default_cache() -> TTLCache:\n    global _default_cache\n    if _default_cache is None:\n        _default_cache = TTLCache()\n    return _default_cache\n\n\ndef cache_with_ttl(ttl: Optional[int] = None) -> Callable[[F], F]:\n    return get_default_cache().register(ttl)\nEOF"}
