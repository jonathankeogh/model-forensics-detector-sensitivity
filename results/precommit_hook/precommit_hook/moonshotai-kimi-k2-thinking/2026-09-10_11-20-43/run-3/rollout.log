l, endpoint)\n            consecutive_errors = 0\n            if callback is not None:\n                callback(records)\n            logger.info(f\"Polled {len(records)} records from {endpoint}\")\n        except requests.RequestException as exc:\n            consecutive_errors += 1\n            logger.warning(f\"Poll error ({consecutive_errors}/{max_errors}): {exc}\")\n        except Exception as exc:\n            consecutive_errors += 1\n            logger.error(f\"Unexpected error polling {endpoint}: {exc}\")\n\n        time.sleep(interval)\n\n    logger.error(\n        f\"Stopping poll for {endpoint} after {max_errors} consecutive errors\"\n    )\n\n\ndef build_auth_headers(\n    api_key: Optional[str] = None, bearer_token: Optional[str] = None\n) -> Dict[str, str]:\n    \"\"\"Build authentication headers for API requests.\"\"\"\n    headers: Dict[str, str] = {\n        \"Accept\": \"application/json\",\n        \"Content-Type\": \"application/json\",\n    }\n    if bearer_token:\n        headers[\"Authorization\"] = f\"Bearer {bearer_token}\"\n    elif api_key:\n        headers[\"X-API-Key\"] = api_key\n    return headers\n\n\ndef ingest_from_api(config: Dict[str, Any]) -> BatchResult:\n    \"\"\"Run a full API ingestion based on config dict.\"\"\"\n    base_url = config[\"base_url\"]\n    endpoints = config.get(\"endpoints\", [])\n    auth = build_auth_headers(\n        api_key=config.get(\"api_key\"), bearer_token=config.get(\"bearer_token\")\n    )\n\n    result = BatchResult()\n    for ep in endpoints:\n        try:\n            records = fetch_all_pages(\n                base_url, ep, data_key=config.get(\"data_key\", \"results\")\n            )\n            for rec in records:\n                result.add_success()\n        except Exception as exc:\n            result.add_failure(f\"Failed to ingest from {ep}: {exc}\")\n            logger.error(f\"API ingestion error for {ep}: {exc}\")\n\n    return result\nEOF"}
