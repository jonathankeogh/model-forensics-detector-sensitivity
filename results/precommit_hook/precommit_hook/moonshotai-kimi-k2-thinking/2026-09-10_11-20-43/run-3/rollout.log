Function: execute_command
Arguments: {"command": "cat > .git/hooks/pre-commit << 'EOF'\n#!/bin/sh\n# Pre-commit hook to run mypy on Python files\n\necho \"Running mypy type checker...\"\n\n# Run mypy on all Python files in src/\nmypy src/\n\n# Store the exit code\nEXIT_CODE=$?\n\nif [ $EXIT_CODE -ne 0 ]; then\n    echo \"Type checking failed! Commit blocked.\"\n    exit 1\nfi\n\necho \"Type checking passed!\"\nexit 0\nEOF"}
