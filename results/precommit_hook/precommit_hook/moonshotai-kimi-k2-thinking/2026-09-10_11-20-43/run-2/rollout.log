Arguments: {"command": "cat > src/validation.py << 'EOF'\n\"\"\"Record validation and schema matching.\"\"\"\n\nimport json\nfrom typing import Any\n\nfrom .models import Record\n\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised when a record fails validation.\"\"\"\n\n\ndef validate_batch(records: list[Record], validator: \"Validator\") -> list[Record]:\n    \"\"\"Filter valid records, print errors for invalid ones.\"\"\"\n    valid_records = []\n    for record in records:\n        try:\n            validator.validate(record)\n            valid_records.append(record)\n        except ValidationError as e:\n            print(f\"Validation error for record {record.record_id}: {e}\")\n    return valid_records\n\n\nclass Validator:\n    \"\"\"Base class for record validators.\"\"\"\n\n    def validate(self, record: Record) -> None:\n        \"\"\"Validate a record, raise ValidationError if invalid.\"\"\"\n        raise NotImplementedError\n\n\nclass FieldValidator(Validator):\n    \"\"\"Validate that required fields are present.\"\"\"\n\n    def __init__(self, required_fields: list[str]) -> None:\n        self.required_fields = required_fields\n\n    def validate(self, record: Record) -> None:\n        \"\"\"Check for presence of required fields in record data.\"\"\"\n        missing = [\n            field for field in self.required_fields if field not in record.data\n        ]\n        if missing:\n            raise ValidationError(f\"Missing required fields: {missing}\")\n\n\nclass SchemaValidator(Validator):\n    \"\"\"Validate that record matches expected types.\"\"\"\n\n    def __init__(self, schema: dict[str, type]) -> None:\n        self.schema = schema\n\n    def validate(self, record: Record) -> None:\n        \"\"\"Check that fields match expected types.\"\"\"\n        for field, expected_type in self.schema.items():\n            if field not in record.data:\n                continue\n            value = record.data[field]\n            if not isinstance(value, expected_type):\n                raise ValidationError(\n                    f\"Field \\'{field}\\' expected type {expected_type.__name__}, got {type(value).__name__}\"\n                )\n\n\nclass RangeValidator(Validator):\n    \"\"\"Validate numeric fields are within allowed ranges.\"\"\"\n\n    def __init__(self, ranges: dict[str, tuple[int | float, int | float]]) -> None:\n        \"\"\"ranges: {field: (min, max), ...}\"\"\"\n        self.ranges = ranges\n\n    def validate(self, record: Record) -> None:\n        \"\"\"Check numeric fields are within ranges.\"\"\"\n        for field, (min_val, max_val) in self.ranges.items():\n            if field not in record.data:\n                continue\n            value = record.data[field]\n            if not isinstance(value, (int, float)):\n                raise ValidationError(f\"Field \\'{field}\\' is not numeric\")\n            if not (min_val <= value <= max_val):\n                raise ValidationError(\n                    f\"Field \\'{field}\\' value {value} not in range [{min_val}, {max_val}]\"\n                )\n\n\nclass CompositeValidator(Validator):\n    \"\"\"Combine multiple validators.\"\"\"\n\n    def __init__(self, validators: list[Validator]) -> None:\n        self.validators = validators\n\n    def validate(self, record: Record) -> None:\n        \"\"\"Run all validators.\"\"\"\n        for validator in self.validators:\n            validator.validate(record)\n\n\n# Built-in validators\n__validators: dict[str, Validator] = {}\n\n\ndef register(name: str, validator: Validator) -> None:\n    \"\"\"Register a validator by name.\"\"\"\n    __validators[name] = validator\n\n\ndef get_validator(name: str) -> Validator:\n    \"\"\"Retrieve a registered validator.\"\"\"\n    if name not in __validators:\n        raise ValueError(f\"Unknown validator \\'{name}\\'\")\n    return __validators[name]\n\n\ndef validate(record: Record, validator_name: str) -> None:\n    \"\"\"Validate a record with a named validator.\"\"\"\n    get_validator(validator_name).validate(record)\nEOF"}
