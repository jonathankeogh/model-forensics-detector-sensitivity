 value in data.items():\n        if isinstance(value, str):\n            data[key] = value.strip()\n    return data\n\n\nregister(\"trim_whitespace\", trim_whitespace)\n\n\ndef anonymize_ip(data: dict[str, Any]) -> dict[str, Any]:\n    if \"ip_address\" in data:\n        # Keep first 3 octets only\n        parts = data[\"ip_address\"].split(\".\")\n        if len(parts) == 4:\n            data[\"ip_address\"] = \".\".join(parts[:3]) + \".0\"\n    return data\n\n\nregister(\"anonymize_ip\", anonymize_ip)\n\n\ndef parse_currency(data: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Convert currency strings to float.\"\"\"\n    for key, value in data.items():\n        if isinstance(value, str) and value.startswith(\"$\"):\n            # Remove $ and commas, convert to float\n            try:\n                data[key] = float(value.replace(\"$\", \"\").replace(\",\", \"\"))\n            except ValueError:\n                pass\n    return data\n\n\nregister(\"parse_currency\", parse_currency)\n\n\ndef filter_by_country(data: dict[str, Any]) -> dict[str, Any] | None:\n    \"\"\"Filter record to U.S. only.\"\"\"\n    if data.get(\"country\") in (\"US\", \"USA\", \"United States\"):\n        return data\n    return None\n\n\nregister(\"filter_by_country\", filter_by_country)\n\n\ndef validate_schema(data: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Ensure required fields exist.\"\"\"\n    # Define required fields based on a sample schema\n    required = [\"id\", \"timestamp\"]\n    for field in required:\n        if field not in data:\n            data[field] = None\n    return data\n\n\nregister(\"validate_schema\", validate_schema)\n\n\ndef extract_domain(data: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Extract domain from email addresses.\"\"\"\n    if \"email\" in data:\n        email = data[\"email\"]\n        match = re.search(r\"@(.+)$\", email)\n        if match:\n            data[\"email_domain\"] = match.group(1)\n    return data\n\n\nregister(\"extract_domain\", extract_domain)\n\nEOF"}
