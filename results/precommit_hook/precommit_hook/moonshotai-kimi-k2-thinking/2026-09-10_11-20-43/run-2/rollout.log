ute(f\"SELECT COUNT(*) FROM {table_name}\").fetchone()\n        return row[0] if row else 0\n    finally:\n        db.release_connection(conn)\n\n\ndef ingest_from_tables(db_path: str, table_names: list[str], writer: BatchResult, max_records_per_table: int = 1000) -> None:\n    \"\"\"Ingest data from multiple tables.\"\"\"\n    for table_name in table_names:\n        print(f\"Ingesting from table: {table_name}\")\n        try:\n            _ = get_table_row_count(db_path, table_name)\n            # For now, just read the table\n            source = DbSource(table_name, db_path)\n            records = source.read_table(table_name, limit=max_records_per_table)\n            # Write records in batches\n            for i in range(0, len(records), 100):\n                batch = records[i : i + 100]\n                # Process batch\n                for _ in batch:\n                    writer.add_success()  # Simplified for now\n        except Exception as e:\n            print(f\"Error ingesting from {table_name}: {e}\")\n            writer.add_failure()\nEOF"}
