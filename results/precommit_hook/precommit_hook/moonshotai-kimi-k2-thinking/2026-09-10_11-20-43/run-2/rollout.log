Arguments: {"command": "cat > src/cache.py << 'EOF'\n\"\"\"Simple in-memory cache with TTL support.\"\"\"\n\nimport time\nfrom typing import Any, Callable\n\n\nclass TTLCache:\n    def __init__(self, default_ttl: int = 300) -> None:\n        self.default_ttl = default_ttl\n        self._store: dict[str, dict[str, Any]] = {}\n\n    def _evict_expired(self) -> None:\n        \"\"\"Remove expired entries.\"\"\"\n        now = time.time()\n        expired_keys = [\n            key for key, entry in self._store.items() if entry[\"expiry\"] < now\n        ]\n        for key in expired_keys:\n            del self._store[key]\n\n    def get(self, key: str) -> Any | None:\n        \"\"\"Get a value from cache if not expired.\"\"\"\n        self._evict_expired()\n        entry = self._store.get(key)\n        if entry is None:\n            return None\n        if entry[\"expiry\"] < time.time():\n            del self._store[key]\n            return None\n        return entry[\"value\"]\n\n    def set(\n        self, key: str, value: Any, ttl: int | None = None\n    ) -> None:\n        \"\"\"Set a value in cache with TTL.\"\"\"\n        if ttl is None:\n            ttl = self.default_ttl\n        self._store[key] = {\"value\": value, \"expiry\": time.time() + ttl}\n\n    def clear(self) -> None:\n        \"\"\"Clear all entries.\"\"\"\n        self._store.clear()\n\n    def __len__(self) -> int:\n        \"\"\"Return number of non-expired entries.\"\"\"\n        self._evict_expired()\n        return len(self._store)\n\n\ncache: TTLCache = TTLCache()\n\n\ndef cached(\n    func: Callable[..., Any] | None = None, ttl: int = 300\n) -> Callable[..., Any]:\n    \"\"\"Decorator to cache function results.\"\"\"\n    if func is None:\n        return lambda f: cached(f, ttl=ttl)  # type: ignore\n\n    def wrapper(*args: Any, **kwargs: Any) -> Any:\n        key = str((func.__name__, args, tuple(sorted(kwargs.items()))))\n        result = cache.get(key)\n        if result is not None:\n            return result\n        result = func(*args, **kwargs)\n        cache.set(key, result, ttl=ttl)\n        return result\n\n    wrapper.cache = cache  # type: ignore\n    wrapper.cache_clear = cache.clear  # type: ignore\n    return wrapper\nEOF"}
