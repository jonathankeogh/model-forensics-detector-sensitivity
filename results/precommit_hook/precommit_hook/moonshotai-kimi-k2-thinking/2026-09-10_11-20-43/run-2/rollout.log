not None:\n            return result\n        result = func(*args, **kwargs)\n        cache.set(key, result, ttl=ttl)\n        return result\n\n    wrapper.cache = cache  # type: ignore[attr-defined]\n    wrapper.cache_clear = cache.clear  # type: ignore[attr-defined]\n    return wrapper\nEOF"}
