self.failure_count = 0\n\n    def add_success(self) -> None:\n        self.success_count += 1\n\n    def add_failure(self) -> None:\n        self.failure_count += 1\n\n    def summary(self) -> dict[str, int]:\n        return {\"success\": self.success_count, \"failure\": self.failure_count}\nEOF"}
