registry[name] = Counter(name, description)\n    return cast(Counter, _registry[name])\n\n\ndef gauge(name: str, description: str = \"\") -> Gauge:\n    \"\"\"Create or get a Gauge metric.\"\"\"\n    if name not in _registry:\n        _registry[name] = Gauge(name, description)\n    return cast(Gauge, _registry[name])\n\n\ndef histogram(name: str, description: str = \"\") -> Histogram:\n    \"\"\"Create or get a Histogram metric.\"\"\"\n    if name not in _registry:\n        _registry[name] = Histogram(name, description)\n    return cast(Histogram, _registry[name])\n\n\ndef get_timings() -> dict[str, dict[str, Any]]:\n    \"\"\"Return a snapshot of all histogram metrics with timings.\"\"\"\n    result: dict[str, dict[str, Any]] = {}\n    for name, metric in _registry.items():\n        if isinstance(metric, Histogram):\n            result[name] = {\n                \"count\": metric.count(),\n                \"sum\": metric.sum(),\n                \"avg\": metric.avg(),\n                \"p50\": metric.percentile(50),\n                \"p95\": metric.percentile(95),\n                \"p99\": metric.percentile(99),\n            }\n    return result\n\n\ndef get_counters() -> dict[str, int]:\n    \"\"\"Return a snapshot of all counter metrics.\"\"\"\n    result: dict[str, int] = {}\n    for name, metric in _registry.items():\n        if isinstance(metric, Counter):\n            result[name] = metric.value()\n    return result\n\n\ndef get_gauges() -> dict[str, float]:\n    \"\"\"Return a snapshot of all gauge metrics.\"\"\"\n    result: dict[str, float] = {}\n    for name, metric in _registry.items():\n        if isinstance(metric, Gauge):\n            result[name] = metric.value()\n    return result\n\n\ndef timer(metric_name: str) -> Callable[[Callable[..., Any]], Callable[..., Any]]:\n    \"\"\"Decorator to time function execution.\"\"\"\n    def decorator(func: Callable[..., Any]) -> Callable[..., Any]:\n        @functools.wraps(func)\n        def wrapper(*args: Any, **kwargs: Any) -> Any:\n            start = time.time()\n            try:\n                result = func(*args, **kwargs)\n                histogram(metric_name).observe(time.time() - start)\n                return result\n            except Exception:\n                histogram(metric_name).observe(time.time() - start)\n                raise\n\n        return wrapper\n\n    return decorator\nEOF"}
