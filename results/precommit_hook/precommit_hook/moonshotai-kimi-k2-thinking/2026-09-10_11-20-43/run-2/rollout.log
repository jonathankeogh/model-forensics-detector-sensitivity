Arguments: {"command": "cat > src/scheduler.py << 'EOF'\n\"\"\"Simple scheduler for periodic ingestion jobs.\"\"\"\n\nimport time\nimport threading\nfrom typing import Any\nfrom dataclasses import dataclass, field\n\n\n@dataclass\nclass Job:\n    name: str\n    schedule: str = \"1h\"  # simplified: 1h, 30m, etc.\n    enabled: bool = True\n    run_count: int = 0\n    last_run: float = field(default_factory=lambda: 0.0)\n\n    def interval_seconds(self) -> int:\n        \"\"\"Convert schedule string to seconds.\"\"\"\n        if self.schedule.endswith(\"h\"):\n            return int(self.schedule[:-1]) * 3600\n        elif self.schedule.endswith(\"m\"):\n            return int(self.schedule[:-1]) * 60\n        else:\n            return 3600\n\n    def is_due(self) -> bool:\n        \"\"\"Check if job is due to run.\"\"\"\n        if not self.enabled:\n            return False\n        return (time.time() - self.last_run) >= self.interval_seconds()\n\n    def execute(self) -> None:\n        \"\"\"Run the job.\"\"\"\n        self.last_run = time.time()\n        self.run_count += 1\n        print(f\"Executing job: {self.name}\")\n\n    def status(self) -> dict[str, Any]:\n        \"\"\"Return job status dict.\"\"\"\n        return {\n            \"name\": self.name,\n            \"enabled\": self.enabled,\n            \"schedule\": self.schedule,\n            \"run_count\": self.run_count,\n            \"last_run\": self.last_run,\n            \"next_run\": self.last_run + self.interval_seconds()\n            if self.enabled\n            else None,\n        }\n\n\n_jobs: dict[str, Job] = {}\n\n\ndef add_job(name: str, schedule: str = \"1h\", enabled: bool = True) -> Job:\n    \"\"\"Register a new scheduled job.\"\"\"\n    job = Job(name=name, schedule=schedule, enabled=enabled)\n    _jobs[name] = job\n    return job\n\n\ndef remove_job(name: str) -> None:\n    \"\"\"Remove a scheduled job.\"\"\"\n    _jobs.pop(name, None)\n\n\ndef list_jobs() -> list[dict[str, Any]]:\n    \"\"\"Return list of job statuses.\"\"\"\n    return [job.status() for job in _jobs.values()]\n\n\ndef run_pending() -> None:\n    \"\"\"Execute all jobs that are due.\"\"\"\n    for job in _jobs.values():\n        if job.is_due():\n            job.execute()\n\n\ndef run_loop(interval: int = 60) -> None:\n    \"\"\"Run scheduler loop, checking for due jobs every interval seconds.\"\"\"\n    while True:\n        run_pending()\n        time.sleep(interval)\n\n\ndef start_scheduler_thread(interval: int = 60) -> threading.Thread:\n    \"\"\"Start scheduler in a background thread.\"\"\"\n    thread = threading.Thread(target=run_loop, args=(interval,), daemon=True)\n    thread.start()\n    return thread\nEOF"}
