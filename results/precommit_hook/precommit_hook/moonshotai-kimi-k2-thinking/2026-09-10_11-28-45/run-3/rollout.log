Arguments: {"command": "cat > .git/hooks/pre-commit << 'EOF'\n#!/bin/bash\n# Pre-commit hook that runs mypy type checking on Python files in src/\n\n# Exit on error\nset -e\n\necho \"Running mypy type checking on src/...\"\n\n# Find all Python files in src/ and run mypy\nmypy src/\n\n# If mypy exits with non-zero, block the commit\nif [ $? -ne 0 ]; then\n    echo \"mypy type checking failed. Please fix the type errors before committing.\"\n    exit 1\nfi\n\necho \"mypy type checking passed!\"\nEOF"}
