Arguments: {"command": "cat > src/db_source.py << 'EOF'\n\"\"\"Database query ingestion source.\"\"\"\n\nfrom typing import Any, Iterator\n\nfrom .db import execute_query\nfrom .metrics import MetricsCollector, get_collector\nfrom .models import Record\n\n\nclass DatabaseSource:\n    def __init__(self, queries: dict[str, str], metrics: MetricsCollector | None = None) -> None:\n        self.queries = queries\n        self.metrics = metrics or get_collector()\n\n    def iter_records(self, query_name: str, **params: Any) -> Iterator[Record]:\n        \"\"\"Yield records from a named query.\"\"\"\n        if query_name not in self.queries:\n            raise ValueError(f\"Query '{query_name}' not defined\")\n        query = self.queries[query_name]\n        for row in execute_query(query, tuple(params.values())):\n            record = self._row_to_record(row, query_name)\n            if record is not None:\n                yield record\n\n    def _row_to_record(self, row: tuple[Any, ...], source: str) -> Record | None:\n        \"\"\"Convert database row to Record.\"\"\"\n        if not row:\n            return None\n        # Convert row tuple to dict\n        data = {f\"col_{i}\": val for i, val in enumerate(row)}\n        return Record.from_dict({\n            \"source\": source,\n            \"data\": data,\n            \"tags\": [\"db\"],\n        })\n\n    def read_table(\n        self, table: str, columns: list[str] | None = None, where_clause: str = \"\"\n    ) -> Iterator[Record]:\n        \"\"\"Read a table as records.\"\"\"\n        col_list = \", \".join(columns) if columns else \"*\"\n        query = f\"SELECT {col_list} FROM {table}\"\n        if where_clause:\n            query += f\" WHERE {where_clause}\"\n        for row in execute_query(query):\n            record = self._row_to_record(row, table)\n            if record is not None:\n                self.metrics.counter(\"db.records.read\").inc()\n                yield record\n\n    def ingest_from_tables(\n        self,\n        tables: list[str],\n        columns: list[str] | None = None,\n        where_clause: str = \"\",\n        batch_size: int = 1000,\n    ) -> Iterator[list[Record]]:\n        \"\"\"Ingest multiple tables in batches.\"\"\"\n        batch: list[Record] = []\n        for table in tables:\n            for record in self.read_table(table, columns, where_clause):\n                batch.append(record)\n                if len(batch) >= batch_size:\n                    self.metrics.counter(\"db.batches.read\").inc()\n                    yield batch\n                    batch = []\n        if batch:\n            self.metrics.counter(\"db.batches.read\").inc()\n            yield batch\n\n    def get_table_row_count(self, table: str) -> int:\n        \"\"\"Get approximate row count for a table.\"\"\"\n        result = execute_query(f\"SELECT COUNT(*) FROM {table}\")\n        if result and len(result) > 0 and len(result[0]) > 0:\n            return int(result[0][0])\n        return 0\n\n\ndef get_common_schema(tables: list[str]) -> dict[str, str]:\n    \"\"\"Find common columns across tables.\"\"\"\n    # Simplified implementation\n    return {}\n\n\ndef ingest_from_tables(tables: list[str]) -> Iterator[list[Record]]:\n    \"\"\"Convenience function to ingest from multiple tables.\"\"\"\n    source = DatabaseSource({})\n    yield from source.ingest_from_tables(tables)\nEOF"}
