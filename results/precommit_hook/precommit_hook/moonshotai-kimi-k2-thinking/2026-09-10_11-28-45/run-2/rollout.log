Arguments: {"command": "cat > src/transform.py << 'EOF'\n\"\"\"Record transformation and enrichment.\"\"\"\n\nimport json\nfrom typing import Any, Callable, Iterator\n\nfrom .models import Record\n\nTransformFunc = Callable[[Record], Record]\n\n\ndef compose(transforms: list[TransformFunc]) -> TransformFunc:\n    \"\"\"Compose multiple transforms into one.\"\"\"\n\n    def composed(record: Record) -> Record:\n        result = record\n        for transform in transforms:\n            result = transform(result)\n        return result\n\n    return composed\n\n\ndef map_field(record: Record, source_field: str, target_field: str) -> Record:\n    \"\"\"Rename or map a field.\"\"\"\n    if source_field in record.data:\n        record.data[target_field] = record.data.pop(source_field)\n    return record\n\n\ndef drop_field(record: Record, field_name: str) -> Record:\n    \"\"\"Remove a field from the record.\"\"\"\n    record.data.pop(field_name, None)\n    return record\n\n\ndef keep_fields(record: Record, fields: list[str]) -> Record:\n    \"\"\"Keep only specified fields.\"\"\"\n    record.data = {k: v for k, v in record.data.items() if k in fields}\n    return record\n\n\ndef add_field(record: Record, name: str, value: Any) -> Record:\n    \"\"\"Add a new field with a static value.\"\"\"\n    record.data[name] = value\n    return record\n\n\ndef parse_json_field(record: Record, field: str) -> Record:\n    \"\"\"Parse a JSON string field into a dict.\"\"\"\n    if field in record.data and isinstance(record.data[field], str):\n        try:\n            record.data[field] = json.loads(record.data[field])\n        except json.JSONDecodeError:\n            pass\n    return record\n\n\ndef flatten(record: Record, separator: str = \"_\") -> Record:\n    \"\"\"Flatten nested dictionaries.\"\"\"\n    new_data: dict[str, Any] = {}\n    for key, value in record.data.items():\n        if isinstance(value, dict):\n            for subkey, subvalue in value.items():\n                new_data[f\"{key}{separator}{subkey}\"] = subvalue\n        else:\n            new_data[key] = value\n    record.data = new_data\n    return record\n\n\ndef add_timestamp(record: Record, field: str = \"processed_at\") -> Record:\n    \"\"\"Add a timestamp field to the record.\"\"\"\n    import time\n\n    record.data[field] = time.time()\n    return record\n\n\nclass TransformRegistry:\n    def __init__(self) -> None:\n        self._transforms: dict[str, TransformFunc] = {}\n\n    def register(self, name: str, func: TransformFunc) -> None:\n        self._transforms[name] = func\n\n    def get(self, name: str) -> TransformFunc:\n        if name not in self._transforms:\n            raise KeyError(f\"Transform '{name}' not found\")\n        return self._transforms[name]\n\n    def list(self) -> list[str]:\n        return list(self._transforms.keys())\n\n\n_registry = TransformRegistry()\n\n\ndef register_transform(name: str, func: TransformFunc) -> None:\n    _registry.register(name, func)\n\n\ndef get_transform(name: str) -> TransformFunc:\n    return _registry.get(name)\n\n\ndef build_pipeline(steps: list[str]) -> TransformFunc:\n    \"\"\"Build a transform pipeline from named transforms.\"\"\"\n    transforms = [get_transform(step) for step in steps]\n    return compose(transforms)\n\n\n# Register some common transforms\nregister_transform(\"add_timestamp\", add_timestamp)\nregister_transform(\"flatten\", flatten)\n\n\ndef apply_transform(transform: TransformFunc, records: list[Record]) -> list[Record]:\n    \"\"\"Apply a transform to a list of records.\"\"\"\n    return [transform(record) for record in records]\n\n\ndef transform_stream(\n    stream: Iterator[Record], transform: TransformFunc\n) -> Iterator[Record]:\n    \"\"\"Apply a transform lazily to a stream of records.\"\"\"\n    for record in stream:\n        yield transform(record)\nEOF"}
