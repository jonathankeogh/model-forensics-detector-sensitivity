(record.data.keys())\n            self._writer.writerow(self._fields)\n\n        row = [record.data.get(field) for field in self._fields]\n        self._writer.writerow(row)\n\n    def flush(self) -> None:\n        if self._file:\n            self._file.flush()\n\n    def close(self) -> None:\n        if self._file:\n            self._file.close()\n            self._file = None\n            self._writer = None\n\n    def __enter__(self) -> \"CsvWriter\":\n        return self\n\n    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None:\n        self.close()\n\n\nclass DatabaseWriter:\n    def __init__(self, table: str) -> None:\n        self.table = table\n        self._batch: list[Record] = []\n\n    def write_record(self, record: Record) -> None:\n        self._batch.append(record)\n\n    def flush(self) -> None:\n        # Simulate writing to database\n        self._batch.clear()\n\n    def close(self) -> None:\n        self.flush()\n\n    def __enter__(self) -> \"DatabaseWriter\":\n        return self\n\n    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None:\n        self.close()\n\n\nclass ConsoleWriter:\n    def write_record(self, record: Record) -> None:\n        print(json.dumps(record.to_dict()))\n\n    def flush(self) -> None:\n        pass\n\n    def close(self) -> None:\n        pass\n\n    def __enter__(self) -> \"ConsoleWriter\":\n        return self\n\n    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None:\n        pass\n\n\nclass MultiWriter:\n    def __init__(self, writers: list[RecordWriter]) -> None:\n        self.writers = writers\n\n    def write_record(self, record: Record) -> None:\n        for writer in self.writers:\n            writer.write_record(record)\n\n    def flush(self) -> None:\n        for writer in self.writers:\n            writer.flush()\n\n    def close(self) -> None:\n        for writer in self.writers:\n            writer.close()\n\n    def __enter__(self) -> \"MultiWriter\":\n        return self\n\n    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None:\n        self.close()\n\n\ndef write_records(records: list[Record], writer: RecordWriter) -> None:\n    for record in records:\n        writer.write_record(record)\n    writer.flush()\n\n\ndef create_writer(output: str | None = None, format: str = \"jsonl\", append: bool = True) -> RecordWriter:\n    if output:\n        if format == \"csv\":\n            return CsvWriter(output, append)\n        elif format == \"db\":\n            return DatabaseWriter(output)\n        else:\n            return JsonlWriter(output, append)\n    return ConsoleWriter()\nEOF"}
