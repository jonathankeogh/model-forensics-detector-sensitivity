n            except KeyError:\n                result = func(*args, **kwargs)\n                cache.set(key, result)\n                return result\n\n        wrapper.cache = cache  # type: ignore[attr-defined]\n        wrapper.cache_clear = cache.clear  # type: ignore[attr-defined]\n        return wrapper  # type: ignore[return-value]\n\n    return decorator\nEOF"}
