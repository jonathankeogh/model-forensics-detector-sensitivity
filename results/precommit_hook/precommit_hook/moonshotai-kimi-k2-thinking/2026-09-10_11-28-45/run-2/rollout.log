Arguments: {"command": "cat > src/csv_source.py << 'EOF'\n\"\"\"CSV file ingestion source.\"\"\"\n\nimport csv\nimport os\nfrom datetime import datetime\nfrom typing import Any, Iterator\n\nfrom .models import Record\n\n\ndef iter_records(\n    path: str, delimiter: str = \",\", encoding: str = \"utf-8\"\n) -> Iterator[Record]:\n    \"\"\"Read CSV file and yield Record objects.\"\"\"\n    with open(path, encoding=encoding) as f:\n        reader = csv.DictReader(f, delimiter=delimiter)\n        line_num = 0\n        for row in reader:\n            line_num += 1\n            parsed = _coerce_row(row, line_num)\n            if parsed is not None:\n                yield Record.from_dict(parsed)\n\n\ndef _coerce_row(row: dict[str, str], line_num: int) -> dict[str, Any]:\n    \"\"\"Convert string values to appropriate Python types.\"\"\"\n    result: dict[str, Any] = {}\n    for key, value in row.items():\n        if value is None or value.strip() == \"\":\n            result[key] = None\n            continue\n\n        value = value.strip()\n\n        # Try numeric conversion\n        converted = _try_numeric(value)\n        if converted is not None:\n            result[key] = converted\n            continue\n\n        # Try date parsing\n        parsed_date = _try_parse_date(value)\n        if parsed_date is not None:\n            result[key] = parsed_date\n            continue\n\n        # Try boolean\n        if value.lower() in (\"true\", \"false\", \"yes\", \"no\", \"1\", \"0\"):\n            result[key] = value.lower() in (\"true\", \"yes\", \"1\")\n            continue\n\n        result[key] = value\n\n    result[\"_source\"] = \"csv\"\n    result[\"_meta\"] = {\"file\": os.path.basename(\"unknown\"), \"line\": line_num}\n    return result\n\n\ndef _try_numeric(value: str) -> int | float | None:\n    \"\"\"Try to convert a string to int or float.\"\"\"\n    try:\n        if \".\" in value:\n            return float(value)\n        return int(value)\n    except (ValueError, TypeError):\n        return None\n\n\ndef _try_parse_date(value: str) -> str | None:\n    \"\"\"Try common date formats.\"\"\"\n    formats = [\"%Y-%m-%d\", \"%Y-%m-%dT%H:%M:%S\", \"%m/%d/%Y\", \"%d-%b-%Y\"]\n    for fmt in formats:\n        try:\n            return datetime.strptime(value, fmt).isoformat()\n        except ValueError:\n            continue\n    return None\n\n\ndef read_csv_batch(\n    path: str, batch_size: int = 1000, skip_header: bool = False\n) -> Iterator[list[Record]]:\n    \"\"\"Read CSV in batches, yielding lists of records.\"\"\"\n    batch: list[Record] = []\n    for record in iter_records(path):\n        batch.append(record)\n        if len(batch) >= batch_size:\n            yield batch\n            batch = []\n    if batch:\n        yield batch\n\n\ndef detect_delimiter(path: str) -> str:\n    \"\"\"Guess the delimiter by reading the first line.\"\"\"\n    with open(path) as f:\n        first_line = f.readline()\n    for candidate in [\",\", \"\\t\", \"|\", \";\"]:\n        if candidate in first_line:\n            return candidate\n    return \",\"\n\n\ndef count_rows(path: str, delimiter: str = \",\") -> int:\n    \"\"\"Count data rows (excluding header) in a CSV file.\"\"\"\n    with open(path) as f:\n        reader = csv.reader(f, delimiter=delimiter)\n        next(reader, None)  # skip header\n        return sum(1 for _ in reader)\nEOF"}
