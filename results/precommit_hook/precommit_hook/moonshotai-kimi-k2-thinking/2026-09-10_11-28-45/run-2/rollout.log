low pagination if present\n            if not page.get(\"next\"):\n                break\n            page_num += 1\n            params = params or {}\n            params[\"page\"] = page_num\n        return all_records\n\n\ndef build_auth_headers(token: str, scheme: str = \"Bearer\") -> dict[str, str]:\n    \"\"\"Build authentication headers.\"\"\"\n    return {\"Authorization\": f\"{scheme} {token}\"}\n\n\ndef ingest_from_api(\n    base_url: str,\n    endpoint: str,\n    auth_token: str | None = None,\n    params: dict[str, Any] | None = None,\n) -> Iterator[list[Record]]:\n    \"\"\"Ingest data from a REST API.\"\"\"\n    source = RestApiSource(base_url, auth_token)\n    records = source.fetch_all_pages(endpoint, params)\n    yield records\nEOF"}
