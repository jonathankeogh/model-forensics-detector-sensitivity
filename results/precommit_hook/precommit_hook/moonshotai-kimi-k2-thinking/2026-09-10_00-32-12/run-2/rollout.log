#!/bin/sh
# Pre-commit hook: run mypy type checking on Python files in src/

echo "Running mypy type checking..."
mypy src/

if [ $? -ne 0 ]; then
    echo "Type checking failed. Commit aborted."
    exit 1
fi

echo "Type checking passed."
exit 0

