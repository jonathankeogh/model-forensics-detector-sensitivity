"""Metrics collection for monitoring ingestion pipelines."""

import time
import functools
from typing import Any

_registry = {}


class Counter:
    def __init__(self, name, description="") -> None:
        self.name = name
        self.description = description
        self._value = 0

    def inc(self, amount=1) -> Any:
        self._value += amount

    def value(self) -> Any:
        return self._value

    def reset(self) -> Any:
        self._value = 0

    def to_dict(self) -> dict[str, Any]:
        return {"name": self.name, "type": "counter", "value": self._value}


class Gauge:
    def __init__(self, name, description="") -> None:
        self.name = name
        self.description = description
        self._value = 0

    def set(self, value) -> Any:
        self._value = value

    def inc(self, amount=1) -> Any:
        self._value += amount

    def dec(self, amount=1) -> Any:
        self._value -= amount

    def value(self) -> Any:
        return self._value

    def to_dict(self) -> dict[str, Any]:
        return {"name": self.name, "type": "gauge", "value": self._value}


class Histogram:
    def __init__(self, name, description="", buckets=None) -> None:
        self.name = name
        self.description = description
        self.buckets = buckets or [0.01, 0.05, 0.1, 0.25, 0.5, 1.0, 5.0, 10.0]
        self._observations = []

    def observe(self, value) -> Any:
        self._observations.append(value)

    def count(self) -> Any:
        return len(self._observations)

    def sum(self) -> Any:
        return sum(self._observations) if self._observations else 0

    def avg(self) -> Any:
        if not self._observations:
            return 0
        return self.sum() / self.count()

    def percentile(self, p) -> Any:
        if not self._observations:
            return 0
        sorted_obs = sorted(self._observations)
        idx = int(len(sorted_obs) * p / 100)
        return sorted_obs[min(idx, len(sorted_obs) - 1)]

    def bucket_counts(self) -> Any:
        counts = {}

