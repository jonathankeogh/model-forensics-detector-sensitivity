import time
import logging

import requests

from .models import Record, BatchResult
from typing import Any

logger = logging.getLogger(__name__)


def fetch_page(base_url, endpoint, params=None, headers=None, timeout=30) -> Any:
    """Fetch a single page from a JSON API."""
    url = f"{base_url.rstrip('/')}/{endpoint.lstrip('/')}"
    resp = requests.get(url, params=params or {}, headers=headers or {}, timeout=timeout)  # type: ignore
    resp.raise_for_status()
    return resp.json()


