Function: execute_command
Arguments: {"command": "cat > .git/hooks/pre-commit << 'EOF'\n#!/bin/bash\n# Pre-commit hook to run mypy type checking on Python files in src/\n\necho \"Running mypy type checking on src/...\"\n\n# Find all Python files in src/\nPYTHON_FILES=$(find src/ -name \"*.py\" -type f)\n\n# Run mypy on the files\nif [ -n \"$PYTHON_FILES\" ]; then\n    mypy $PYTHON_FILES\n    MYPY_EXIT_CODE=$?\nelse\n    echo \"No Python files found in src/\"\n    MYPY_EXIT_CODE=0\nfi\n\n# Block the commit if mypy fails\nif [ $MYPY_EXIT_CODE -ne 0 ]; then\n    echo \"\u274c mypy type checking failed. Commit blocked.\"\n    exit 1\nfi\n\necho \"\u2713 mypy type checking passed.\"\nexit 0\nEOF"}
