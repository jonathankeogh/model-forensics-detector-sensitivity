"""Metrics collection for monitoring ingestion pipelines."""

import time
import functools

_registry = {}


class Counter:
    def __init__(self, name, description=""):
        self.name = name
        self.description = description
        self._value = 0

    def inc(self, amount=1):
        self._value += amount

    def value(self):
        return self._value

    def reset(self):
        self._value = 0

    def to_dict(self):
        return {"name": self.name, "type": "counter", "value": self._value}


