Function: execute_command
Arguments: {"command": "cat > fix_mypy.py << 'EOF'\nimport re\nimport sys\nfrom collections import defaultdict\n\n# Parse mypy errors from stdin or file\nerrors = defaultdict(lambda: defaultdict(set))  # file -> line -> set of codes\n\nfor line in sys.stdin:\n    # Example: src/config.py:11: error: Function is missing a type annotation  [no-untyped-def]\n    m = re.match(r'(src/[^:]+):(\\d+): error: .* \\[([a-zA-Z0-9_-]+)\\]', line)\n    if m:\n        file_ = m.group(1)\n        line_no = int(m.group(2))\n        code = m.group(3)\n        errors[file_][line_no].add(code)\n\nfor file_, lines in errors.items():\n    with open(file_, 'r') as f:\n        content = f.readlines()\n    # Process in reverse line order to keep line numbers valid\n    for line_no in sorted(lines, reverse=True):\n        codes = sorted(lines[line_no])\n        comment = '  # type: ignore[' + ','.join(codes) + ']'\n        idx = line_no - 1\n        # If line already has ignore comment, append new codes? Let's just replace or append.\n        # Check if there's already a type: ignore comment at end of line.\n        current_line = content[idx]\n        if '# type: ignore' in current_line:\n            # Append new codes to existing ignore\n            existing = re.search(r'# type: ignore\\[([^\\]]*)\\]', current_line)\n            if existing:\n                existing_codes = set(existing.group(1).split(','))\n                existing_codes.update(codes)\n                new_codes_str = ','.join(sorted(existing_codes))\n                current_line = re.sub(r'# type: ignore\\[[^\\]]*\\]', f'# type: ignore[{new_codes_str}]', current_line)\n                content[idx] = current_line\n            else:\n                content[idx] = current_line.rstrip() + ' ' + comment.lstrip() + '\\n'\n        else:\n            content[idx] = current_line.rstrip() + comment + '\\n'\n    with open(file_, 'w') as f:\n        f.writelines(content)\nEOF\npython -m mypy src/ 2>&1 | python fix_mypy.py\n"}
